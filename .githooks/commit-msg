#!/usr/bin/env bash
# Git commit-msg hook enforcing Conventional Commits and Co-authored-by trailer

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

# Check for Conventional Commits prefix (ignoring merge or initial commits)
pattern="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_\.-]+\))?: .+"
first_line=$(head -n 1 "$commit_msg_file")

if [[ ! "$first_line" =~ $pattern ]]; then
    echo "ERROR: Commit message first line does not match Conventional Commits format!" >&2
    echo "Expected: <type>(<optional-scope>): <description>" >&2
    echo "Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert" >&2
    echo "Actual:   $first_line" >&2
    exit 1
fi

# Mandatory co-author trailer check
coauthor_trailer="Co-authored-by: toiyeuyuriiiii <toiyeuyuriiiii+github@gmail.com>"
if ! grep -Fq "$coauthor_trailer" "$commit_msg_file"; then
    echo "ERROR: Commit message is missing mandatory co-author trailer!" >&2
    echo "Must include verbatim:" >&2
    echo "  $coauthor_trailer" >&2
    exit 1
fi

exit 0
